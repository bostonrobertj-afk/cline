            "type": "string",
            "description": "Click coordinate as `x,y` within the browser viewport."
          },
          "text": {
            "type": "string",
            "description": "Text for `type`."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
