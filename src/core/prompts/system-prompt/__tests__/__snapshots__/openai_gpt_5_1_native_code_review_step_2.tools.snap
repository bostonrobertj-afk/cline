[
  {
    "type": "function",
    "function": {
      "name": "execute_command",
      "description": "Run a shell command in the current workspace.",
      "strict": false,
      "parameters": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "The CLI command to execute."
          },
          "requires_approval": {
            "type": "boolean",
            "description": "Set true for impactful or risky commands; false for safe non-destructive commands."
          }
        },
        "required": [
          "command",
          "requires_approval"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_file",
      "description": "Use Indxr first for discovery, summaries, symbol lookup, dependency tracing, and targeted source reads. Once the task is narrowed to one concrete file, use read_file when exact full raw file contents are required for a file at or below 800 lines and 65536 bytes, or when Indxr is insufficient.",
      "strict": false,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the file to read (relative to the current working directory /test/project)"
          },
          "task_progress": {
            "type": "string",
            "description": "Top-level tool parameter, not a standalone tool. Pass a full Markdown checklist to create the task list. After a checklist exists, use `__COMPLETE_NEXT_STEP__` to complete the next incomplete step."
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_file_range",
      "description": "Use only when exact raw line-based inspection is required after Indxr has already narrowed the target, when the file exceeds the full-read limit, or when Indxr is insufficient.",
      "strict": false,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The path of the file to read (relative to the current working directory /test/project)"
          },
          "start_line": {
            "type": "integer",
            "description": "The first line to include, using 1-based line numbers."
          },
          "end_line": {
            "type": "integer",
            "description": "The last line to include, using 1-based line numbers."
          },
          "task_progress": {
            "type": "string",
            "description": "Top-level tool parameter, not a standalone tool. Pass a full Markdown checklist to create the task list. After a checklist exists, use `__COMPLETE_NEXT_STEP__` to complete the next incomplete step."
          }
        },
        "required": [
          "path",
          "start_line",
          "end_line"
        ],
        "additionalProperties": false
      }
    }
  },
